# Replace both placeholders with distinct keys for the configured model.
LLM_API_KEYS=replace_first_key,replace_second_key
LLM_MODEL=gemini/gemini-2.5-flash
# Optional, for a compatible OpenAI-style inference endpoint.
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=18
LLM_CACHE_TTL_SECONDS=600
# Use sqlite:///./data/app.db for local Python startup outside Docker.
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
VITE_API_BASE_URL=http://localhost:8000
# Container default. Hosts can supply their own service port.
PORT=8000
